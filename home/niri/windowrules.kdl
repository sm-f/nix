// --- Rounded corners for all windows ---
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// --- Remove border background from transparent windows ---
window-rule {
    draw-border-with-background false
}

// --- Floating windows: always floating ---
window-rule {
    match title=r#"(?i)^picture-in-picture$"# // PiP windows
    match app-id=r#"(?i)^org.remmina.Remmina$"# title=r#"^Remmina Remote Desktop Client$"# // Remmina (main window only)
    match app-id=r#"(?i)(nautilus|blueman|pavucontrol|keepass|nm-connection-editor|waypaper|com.network.manager)"# // always floating apps regardless of window title
    open-floating true
}

// Indicate screencasted windows with red colors.
window-rule {
    match is-window-cast-target=true
    border {
        active-gradient from="#ff6e5e" to="#ffbd5e" angle=45
        inactive-gradient from="#ffbd5e90" to="#ff5ea090" angle=135
    }
}

// --- Wallpaper stays in place when switching workspaces ---
layer-rule {
    match namespace="quickshell"
    place-within-backdrop true
}
