input {
    keyboard {
        xkb {
            layout "nz(mao)"
            options "caps:escape"
        }
        repeat-delay 250
        repeat-rate  30
    }
    focus-follows-mouse max-scroll-amount="0%"
    disable-power-key-handling // see https://github.com/niri-wm/niri/issues/2233
    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
    }
}

gestures {
    hot-corners { off; }
    dnd-edge-view-scroll { trigger-width 100; max-speed 3000; }
}
